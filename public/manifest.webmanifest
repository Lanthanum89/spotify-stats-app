{
  "id": "/spotify-stats-app/",
  "name": "SoundTracks",
  "short_name": "SoundTracks",
  "description": "Your personal Spotify listening stats and insights.",
  "lang": "en-GB",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0b0a0f",
  "theme_color": "#0b0a0f",
  "categories": ["music", "entertainment"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Search", "short_name": "Search", "description": "Search Spotify and your listening", "url": "./#/search" },
    { "name": "Top Tracks", "short_name": "Tracks", "description": "Your most-played tracks", "url": "./#/tracks" },
    { "name": "Recently played", "short_name": "Recent", "description": "What you listened to lately", "url": "./#/recent" }
  ]
}
